---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { materias } from '../../../data/materias';

export function getStaticPaths() {
  return materias.map((m) => ({ params: { materia: m.slug }, props: { m } }));
}
const { m } = Astro.props;
const entradas = (await getCollection('materias')).filter((c) => c.data.materia === m.slug && !c.data.draft);
const clases = entradas.filter((c) => c.data.tipo === 'clase').sort((a, b) => (a.data.clase ?? 0) - (b.data.clase ?? 0));
const herramientas = entradas
  .filter((c) => c.data.tipo === 'herramienta')
  .sort((a, b) => (a.data.orden ?? 99) - (b.data.orden ?? 99));
const slugDe = (c: (typeof entradas)[number]) => c.id.split('/').pop()?.replace(/\.mdx?$/, '');
---

<BaseLayout title={`${m.nombre} — Material de cátedra`} description={m.descripcion}>
  <section class="mat-hero">
    <div class="container">
      <p class="mat-crumb"><a href="/docencia">Materias universitarias</a> / {m.corto}</p>
      <h1>{m.nombre}</h1>
      <p class="mat-uni">{m.universidad}</p>
      <p class="mat-lead">{m.descripcion}</p>
    </div>
  </section>

  <section class="mat-list-section">
    <div class="container">
      {herramientas.length > 0 && (
        <div class="mat-tools">
          <h2 class="mat-h2">Herramientas</h2>
          <ul class="mat-list">
            {herramientas.map((c) => (
              <li>
                <a href={`/docencia/${m.slug}/${slugDe(c)}`} class="mat-item mat-item--tool">
                  <span class="mat-num">Herramienta interactiva</span>
                  <span class="mat-title">{c.data.title}</span>
                  <span class="mat-desc">{c.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
      <h2 class="mat-h2">Clases</h2>
      {clases.length === 0 ? (
        <p class="mat-empty">Las clases se irán publicando a lo largo del cuatrimestre.</p>
      ) : (
        <ol class="mat-list">
          {clases.map((c) => (
            <li>
              <a href={`/docencia/${m.slug}/${slugDe(c)}`} class="mat-item">
                <span class="mat-num">Clase {c.data.clase}</span>
                <span class="mat-title">{c.data.title}</span>
                <span class="mat-desc">{c.data.description}</span>
              </a>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .mat-hero { padding: var(--space-xl) 0 var(--space-lg); background: var(--color-surface); border-bottom: 1px solid var(--color-border); }
  .mat-crumb { font-size: 0.85rem; color: var(--color-muted); margin-bottom: 0.75rem; }
  .mat-hero h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); margin-bottom: 0.4rem; }
  .mat-uni { color: var(--color-accent); font-weight: 600; font-size: 0.9rem; margin-bottom: 1rem; }
  .mat-lead { color: var(--color-muted); max-width: 60ch; }
  .mat-list-section { padding: var(--space-xl) 0; }
  .mat-list { list-style: none; display: flex; flex-direction: column; gap: 0.75rem; }
  .mat-item { display: grid; gap: 0.2rem; padding: 1rem 1.25rem; background: #fff; border: 1px solid var(--color-border); border-radius: 10px; text-decoration: none; color: var(--color-text); transition: border-color 0.2s; }
  .mat-item:hover { border-color: var(--color-accent); opacity: 1; }
  .mat-num { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent); }
  .mat-title { font-family: var(--font-display); font-size: 1.15rem; font-weight: 700; }
  .mat-desc { color: var(--color-muted); font-size: 0.92rem; }
  .mat-h2 { font-size: 1.3rem; margin: 0 0 0.9rem; }
  .mat-tools { margin-bottom: var(--space-lg); }
  .mat-item--tool { border-left: 4px solid var(--color-accent); }
  .mat-empty { color: var(--color-muted); }
</style>
