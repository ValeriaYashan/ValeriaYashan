---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { materias } from '../../../data/materias';

export function getStaticPaths() {
  return materias.map((m) => ({ params: { materia: m.slug }, props: { m } }));
}
const { m } = Astro.props;
const entradas = (await getCollection('materias')).filter((c) => c.data.materia === m.slug && !c.data.draft);
const clases = entradas.filter((c) => c.data.tipo === 'clase').sort((a, b) => (a.data.clase ?? 0) - (b.data.clase ?? 0));
const herramientas = entradas
  .filter((c) => c.data.tipo === 'herramienta')
  .sort((a, b) => (a.data.orden ?? 99) - (b.data.orden ?? 99));
const apuntes = entradas
  .filter((c) => c.data.tipo === 'apunte')
  .sort((a, b) => (a.data.orden ?? 99) - (b.data.orden ?? 99));
const sinClases = (m as any).sinClases === true;
const docentes = (m as any).docentes as undefined | { intro: string; actividades: { nombre: string; objetivo: string }[]; uso: string };
const slugDe = (c: (typeof entradas)[number]) => c.id.split('/').pop()?.replace(/\.mdx?$/, '');
---

<BaseLayout title={`${m.nombre} — Material de cátedra`} description={m.descripcion}>
  <section class="mat-hero">
    <div class="container">
      <p class="mat-crumb"><a href="/docencia">Materias universitarias</a> / {m.corto}</p>
      <h1>{m.nombre}</h1>
      <p class="mat-uni">{m.universidad}</p>
      <p class="mat-lead">{m.descripcion}</p>
    </div>
  </section>

  <section class="mat-list-section">
    <div class="container">
      {docentes && (
        <aside class="mat-docentes" aria-labelledby="docentes-h">
          <h2 class="mat-h2" id="docentes-h">Para docentes y coordinadores</h2>
          <p>{docentes.intro}</p>
          <dl>
            {docentes.actividades.map((a) => (
              <>
                <dt>{a.nombre}</dt>
                <dd>{a.objetivo}</dd>
              </>
            ))}
          </dl>
          <p>{docentes.uso}</p>
          <p class="mat-docentes-cta">¿Querés adaptarlas a tu institución? <a href="/contacto">Escribime.</a></p>
        </aside>
      )}
      {herramientas.length > 0 && (
        <div class="mat-tools">
          <h2 class="mat-h2">Ruta de herramientas</h2>
          <p class="mat-progress" id="mat-progress" hidden></p>
          <ol class="mat-list">
            {herramientas.map((c, i) => (
              <li>
                <a href={`/docencia/${m.slug}/${slugDe(c)}`} class="mat-item mat-item--tool" data-prog={`vy-prog:${slugDe(c)}`}>
                  <span class="mat-num">
                    {`Paso ${i + 1}`}{c.data.etapa ? ` · ${c.data.etapa}` : ''}
                    <span class="mat-badge" hidden></span>
                  </span>
                  <span class="mat-title">{c.data.title}</span>
                  <span class="mat-desc">{c.data.description}</span>
                  {(c.data.unidades || c.data.duracion || c.data.modalidad) && (
                    <span class="mat-meta">
                      {[c.data.unidades, c.data.duracion, c.data.modalidad].filter(Boolean).join(' · ')}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ol>
        </div>
      )}
      {apuntes.length > 0 && (
        <div class="mat-tools">
          <h2 class="mat-h2">Apuntes</h2>
          <ol class="mat-list">
            {apuntes.map((c) => (
              <li>
                <a href={`/docencia/${m.slug}/${slugDe(c)}`} class="mat-item">
                  <span class="mat-title">{c.data.title}</span>
                  <span class="mat-desc">{c.data.description}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      )}
      {!sinClases && <h2 class="mat-h2" id="clases">Clases</h2>}
      {sinClases ? null : clases.length === 0 ? (
        <p class="mat-empty">Las clases se irán publicando a lo largo del cuatrimestre.</p>
      ) : (
        <ol class="mat-list">
          {clases.map((c) => (
            <li>
              <a href={`/docencia/${m.slug}/${slugDe(c)}`} class="mat-item">
                <span class="mat-num">Clase {c.data.clase}</span>
                <span class="mat-title">{c.data.title}</span>
                <span class="mat-desc">{c.data.description}</span>
              </a>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Progreso personal: se guarda solo en este navegador (localStorage), no se envía a ningún lado.
  (function () {
    try {
      var cards = document.querySelectorAll('[data-prog]');
      var hechas = 0;
      cards.forEach(function (a) {
        var raw = localStorage.getItem(a.getAttribute('data-prog'));
        if (!raw) return;
        hechas++;
        var info = {};
        try { info = JSON.parse(raw) || {}; } catch (e) {}
        var b = a.querySelector('.mat-badge');
        b.textContent = info.n && info.n !== 'Usada' ? '✓ Completada · ' + info.n : '✓ ' + (info.n === 'Usada' ? 'Usada' : 'Completada');
        b.hidden = false;
        a.classList.add('is-done');
      });
      var p = document.getElementById('mat-progress');
      if (p && cards.length && hechas) {
        p.textContent = 'Tu avance en este dispositivo: ' + hechas + ' de ' + cards.length + ' herramientas.';
        p.hidden = false;
      }
    } catch (e) {}
  })();
</script>

<style>
  .mat-hero { padding: var(--space-xl) 0 var(--space-lg); background: var(--color-surface); border-bottom: 1px solid var(--color-border); }
  .mat-crumb { font-size: 0.85rem; color: var(--color-muted); margin-bottom: 0.75rem; }
  .mat-hero h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); margin-bottom: 0.4rem; }
  .mat-uni { color: var(--color-accent); font-weight: 600; font-size: 0.9rem; margin-bottom: 1rem; }
  .mat-lead { color: var(--color-muted); max-width: 60ch; }
  .mat-list-section { padding: var(--space-xl) 0; }
  .mat-list { list-style: none; display: flex; flex-direction: column; gap: 0.75rem; }
  .mat-item { display: grid; gap: 0.2rem; padding: 1rem 1.25rem; background: #fff; border: 1px solid var(--color-border); border-radius: 10px; text-decoration: none; color: var(--color-text); transition: border-color 0.2s; }
  .mat-item:hover { border-color: var(--color-accent); opacity: 1; }
  .mat-num { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent); }
  .mat-title { font-family: var(--font-display); font-size: 1.15rem; font-weight: 700; }
  .mat-desc { color: var(--color-muted); font-size: 0.92rem; }
  .mat-h2 { font-size: 1.3rem; margin: 0 0 0.9rem; }
  .mat-tools { margin-bottom: var(--space-lg); }
  .mat-item--tool { border-left: 4px solid var(--color-accent); }
  .mat-docentes { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; padding: var(--space-md); margin-bottom: var(--space-lg); }
  .mat-docentes p { margin-bottom: 0.9rem; color: var(--color-text); max-width: 70ch; }
  .mat-docentes dl { margin: 0 0 0.9rem; }
  .mat-docentes dt { font-weight: 600; margin-top: 0.6rem; }
  .mat-docentes dd { margin: 0.1rem 0 0; color: var(--color-muted); max-width: 70ch; }
  .mat-docentes-cta { margin-bottom: 0; font-size: 0.95rem; }
  .mat-progress { color: var(--color-muted); font-size: 0.9rem; margin: -0.4rem 0 0.9rem; }
  .mat-badge { margin-left: 0.6rem; padding: 0.1rem 0.5rem; border-radius: 999px; background: var(--color-accent); color: #fff; font-size: 0.72rem; letter-spacing: 0; text-transform: none; }
  .mat-meta { font-size: 0.82rem; color: var(--color-accent); font-weight: 600; margin-top: 0.2rem; }
  .mat-item.is-done { background: #F4F8F5; }
  .mat-empty { color: var(--color-muted); }
</style>
