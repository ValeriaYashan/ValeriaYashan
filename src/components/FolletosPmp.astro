---
// src/components/FolletosPmp.astro
// Folletos Heyzine: preparación para el examen PMP® e inscripción.
// Para agregar o cambiar un folleto, editá solo este array.
// Si "url" queda vacío, ese folleto no se muestra.
const folletos = [
  {
    id: 'folleto-pmp',
    titulo: 'Folleto: Preparación para el examen PMP®',
    desc: 'Programa completo de la preparación: contenidos, sesiones, metodología y cómo trabajamos hasta el día del examen.',
    url: 'https://heyzine.com/flip-book/8201887df0.html',
    iframeTitle: 'Folleto Preparación para el examen PMP® — Valeria Yashan',
  },
  {
    id: 'folleto-inscripcion',
    titulo: 'Folleto: Inscripción',
    desc: 'Cómo inscribirte, modalidad de pago y pasos para reservar tu lugar en la próxima cohorte.',
    url: '', // pegá acá el link de Heyzine del folleto de inscripción
    iframeTitle: 'Folleto de inscripción — Valeria Yashan',
  },
].filter((f) => f.url);

// Formulario de inscripción (Google Forms)
const formularioUrl = 'https://forms.gle/uptWqab7ZEafp47Z9';
---

{folletos.length > 0 && (
  <section class="fol-section">
    <div class="fol-inner">
      <h2 class="fol-titulo-seccion">Folletos de la preparación PMP®</h2>
      <p class="fol-sub">
        Recorré los folletos acá mismo o abrilos en pantalla completa.
      </p>

      <div class="fol-grid">
        {folletos.map((f) => (
          <article class="fol-card" id={f.id}>
            <h3 class="fol-card-titulo">{f.titulo}</h3>
            <p class="fol-card-desc">{f.desc}</p>
            <div class="fol-embed">
              <iframe
                src={f.url}
                loading="lazy"
                allowfullscreen
                title={f.iframeTitle}
              ></iframe>
            </div>
            <a href={f.url} class="fol-btn" target="_blank" rel="noopener">
              Abrir en pantalla completa
            </a>
          </article>
        ))}
      </div>

      <div class="fol-inscripcion">
        <div>
          <p class="fol-inscripcion-titulo">¿Querés sumarte a la próxima cohorte?</p>
          <p class="fol-inscripcion-desc">
            Completá el formulario de inscripción y te escribo con las fechas y los pasos a seguir.
          </p>
        </div>
        <a href={formularioUrl} class="fol-btn" target="_blank" rel="noopener">
          Inscribirme
        </a>
      </div>
    </div>
  </section>
)}

<style>
  .fol-section {
    padding: 4rem 1.5rem;
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .fol-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .fol-titulo-seccion {
    font-family: 'Fraunces', serif;
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }

  .fol-sub {
    font-size: 1rem;
    color: var(--color-muted);
    line-height: 1.6;
    max-width: 600px;
    margin-bottom: 2rem;
  }

  .fol-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 900px) {
    .fol-grid {
      grid-template-columns: 1fr;
    }
  }

  .fol-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    scroll-margin-top: 90px;
  }

  .fol-card-titulo {
    font-family: 'Inter', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }

  .fol-card-desc {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .fol-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .fol-embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .fol-btn {
    display: inline-block;
    align-self: flex-start;
    background: var(--color-accent);
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .fol-btn:hover {
    opacity: 0.88;
  }

  .fol-inscripcion {
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.5rem 2rem;
  }

  .fol-inscripcion-titulo {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.25rem;
  }

  .fol-inscripcion-desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.5;
    margin: 0;
  }
</style>
